# AlgoViz+ Supabase Configuration
# Copy this file to `.env` and fill in real values from:
#   Supabase Dashboard → Settings → API
#   Google Cloud Console → Credentials → OAuth 2.0 Client IDs (Web)

EXPO_PUBLIC_SUPABASE_URL=https://zosawqjebxkjppwtkegx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth (Web Client ID from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
