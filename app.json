{
  "expo": {
    "name": "AlgoViz+",
    "slug": "algoviz-reactnative",
    "version": "1.0.0",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/d8e8a917-0e90-4acb-8dd6-63ae582d116f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "algovizplus",
    "userInterfaceStyle": "automatic",

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.algoviz.plus",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["algovizplus"]
          }
        ]
      }
    },

    "android": {
      "package": "com.algoviz.plus",
      "adaptiveIcon": {
        "backgroundColor": "#1E1E2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-updates",
      [
        "expo-image-picker",
        {
          "photosPermission": "AlgoViz+ needs photo library access so you can choose a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E1E2E"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "d8e8a917-0e90-4acb-8dd6-63ae582d116f"
      }
    }
  }
}