{
  "expo": {
    "name": "AlgoViz+",
    "slug": "algoviz-reactnative",
    "version": "1.0.0",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "algovizplus",
    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1E2E"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.algoviz.plus",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["algovizplus"]
          }
        ]
      }
    },

    "android": {
      "package": "com.algoviz.plus",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E1E2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],

    "extra": {
      "eas": {
        "projectId": "d8e8a917-0e90-4acb-8dd6-63ae582d116f"
      }
    }
  }
}